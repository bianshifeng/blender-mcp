{
  "schema": "metaori.workflow/1",
  "id": "t2i_qwen_image_2_1_ref",
  "capability": "text_to_image",
  "default": false,
  "description": "Qwen Image 2.1 (int8) text-to-image with up to 6 reference images (subject, style or layout guidance; the prompt says how to use them) and 3 optional LoRA slots. euler/simple, cfg 1. Picked automatically when reference_images are given.",
  "graph": "workflow_api.json",
  "inputs": {
    "prompt": [
      {
        "node": "100",
        "class_type": "PrimitiveStringMultiline",
        "input": "value"
      }
    ],
    "negative_prompt": [
      {
        "node": "101",
        "class_type": "PrimitiveStringMultiline",
        "input": "value"
      }
    ],
    "width": [
      {
        "node": "103",
        "class_type": "PrimitiveInt",
        "input": "value"
      }
    ],
    "height": [
      {
        "node": "104",
        "class_type": "PrimitiveInt",
        "input": "value"
      }
    ],
    "count": [
      {
        "node": "6",
        "class_type": "EmptyLatentImage",
        "input": "batch_size"
      }
    ],
