      },
      {
        "set": {
          "node": "106",
          "class_type": "LoadImage",
          "input": "image"
        },
        "detach": [
          {
            "node": "5",
            "class_type": "TextEncodeQwenImage21",
            "input": "images.image_2"
          }
        ]
      },
      {
        "set": {
          "node": "107",
          "class_type": "LoadImage",
          "input": "image"
