      {
        "set": {
          "node": "109",
          "class_type": "LoadImage",
          "input": "image"
        },
        "detach": [
          {
            "node": "5",
            "class_type": "TextEncodeQwenImage21",
            "input": "images.image_5"
          }
        ]
      },
      {
        "set": {
          "node": "110",
          "class_type": "LoadImage",
          "input": "image"
        },
        "detach": [
          {
            "node": "5",
            "class_type": "TextEncodeQwenImage21",
            "input": "images.image_6"
          }
        ]
      }
    ]
  },
  "extras": {
    "steps": {
      "type": "int",
      "description": "Sampling steps; more is slower and rarely better above 30.",
      "default": 25,
      "min": 1,
      "max": 100,
      "bind": [
        {
          "node": "7",
          "class_type": "KSampler",
          "input": "steps"
        }
      ]
    },
    "reference_resolution": {
      "type": "int",
      "description": "Reference images are resized to about this many pixels per side (multiple of 32); 0 keeps their own size.",
      "default": 1024,
      "min": 0,
      "max": 4096,
      "bind": [
        {
          "node": "5",
          "class_type": "TextEncodeQwenImage21",
          "input": "resolution"
        }
      ]
    },
    "lora_1": {
      "type": "str",
      "description": "LoRA file for slot 1, as listed by ComfyUI (e.g. Qwen-Image2.1\\style\\x.safetensors); only used when lora_1_strength is not 0.",
      "default": "Qwen-Image2.1\\style\\mvc5000_qwen21.safetensors",
      "bind": [
        {
          "node": "9001",
          "class_type": "LoraLoaderModelOnly",
