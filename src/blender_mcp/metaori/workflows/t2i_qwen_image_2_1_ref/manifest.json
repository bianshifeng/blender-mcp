        }
      ]
    },
    "lora_2_strength": {
      "type": "float",
      "description": "Strength of LoRA slot 2; 0 (default) leaves the slot empty.",
      "default": 0.0,
      "min": -2.0,
      "max": 2.0,
      "bind": [
        {
          "node": "9002",
          "class_type": "LoraLoaderModelOnly",
